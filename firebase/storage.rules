rules_version = '2';

// Cloud Storage rules (docs/SECURITY.md §2.3). Deny by default; each owner edits only their section.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() { return request.auth != null; }
    function isStaff() {
      return isSignedIn()
        && request.auth.token.get('role', null) in ['owner', 'staff']
        && request.auth.token.firebase.get('sign_in_second_factor', null) == 'totp'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', null) == request.auth.token.role;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ── catalog (owner: B) ─────────────────────────────────────────────────────────────────────────────────────
    // Product, banner and shop photos: public read (the app builds plain URLs), staff write of one folder level,
    // image/(webp|jpeg|png) only, at most 1 MB (the old bucket's 1048576-byte cap). Keys are never reused.
    match /product-images/{folder}/{file} {
      allow read: if true;
      allow create, update: if isStaff() && folder.matches('[A-Za-z0-9_-]{1,80}')
        && file.matches('[A-Za-z0-9_@-]{1,80}[.](webp|jpe?g|png)')
        && request.resource.size <= 1048576
        && request.resource.contentType.matches('image/(webp|jpeg|png)');
      allow delete: if isStaff();
    }

    // ── invoices (owner: D, Phase 2) ───────────────────────────────────────────────────────────────────────────
    // TODO(D): invoices/{uid}/{orderId}.pdf readable by that uid or staff; no client writes.
  }
}
