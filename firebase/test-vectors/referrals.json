    {
      "id": "delivery-pays-the-referrer",
      "source": "supabase/tests/offers.test.sql:402",
      "about": "The referee's order (subtotal 1000000 ≥ minOrderPaise 199900, compared before the discount) is delivered: alice gets a personal hidden flat coupon for rewardPaise, code REWARD + 10 hex chars (regex not expressible), and the referral is marked rewarded (offers.test.sql:403-404). Limits and 90-day end come from reward_referral's insert (derived); the referralRewards month key is the IST month of \"now\".",
      "as": "staff",
      "given": {
        "referrals/carol": {
          "referrerUid": "alice",
          "status": "pending"
        },
        "orders/c1": {
          "uid": "carol",
          "status": "shipped",
          "paymentMethod": "cod",
          "paymentStatus": "pending",
          "subtotalPaise": 1000000,
          "deliveryFeePaise": 0,
          "discountPaise": 20000,
          "totalPaise": 980000,
          "items": [
            {
              "id": "v1",
              "productId": "test-phone",
              "productName": "Test Phone",
              "variantName": "Phone",
              "unitPricePaise": 1000000,
              "qty": 1,
              "gstRateBp": 1800,
              "discountPaise": 20000,
              "imeis": []
            }
          ],
          "events": [
            {
              "status": "confirmed",
              "by": "customer",
              "byUid": "carol",
              "at": "@now-3h"
            },
            {
              "status": "packed",
              "by": "staff",
              "byUid": "staff",
              "at": "@now-2h"
            },
            {
              "status": "shipped",
              "by": "staff",
              "byUid": "staff",
              "at": "@now-1h"
            }
          ]
        }
      },
      "call": "adminUpdateOrder",
      "input": {
        "orderId": "c1",
        "status": "delivered"
      },
      "then": {
        "referrals/carol": {
          "status": "rewarded",
          "rewardedAt": "@now"
        },
        "promotions/*": {
          "title": "Thanks for referring a friend",
          "kind": "flat",
          "value": 20000,
          "minSubtotalPaise": 199900,
          "endsAt": "@now+90d",
          "usageLimit": 1,
          "perUserLimit": 1,
          "firstOrderOnly": false,
          "isPublic": false,
          "uid": "alice",
          "isActive": true
        },
        "users/alice/coupons/*": {
          "title": "Thanks for referring a friend",
          "kind": "flat",
          "value": 20000,
          "minSubtotalPaise": 199900
        },
        "users/alice": {
          "referralRewards": {
            "202611": 1
          }
        }
      }
    },
