<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Address form "Use my current location": asked only when tapped. Android's geocoder (Google Play
         services) turns the position into an address; the app doesn't store or send the coordinates itself.
         Approximate location is enough. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Cleartext is off explicitly: minSdk 24 and Android 7–8.1 default it to on. Debug/profile override it for
         the local stack. Plugin permissions merged in (checked in the merged manifest): NFC, READ_BASIC_PHONE_STATE,
         ACCESS_NETWORK_STATE from Razorpay; USE_BIOMETRIC/USE_FINGERPRINT from androidx.biometric (Razorpay /
         Google Pay); BIND_GET_INSTALL_REFERRER_SERVICE from Play's install referrer (share links after an
         install). All are install-time "normal" permissions with no prompt, and the Razorpay checkout may call the
         APIs they guard (a missing one throws SecurityException mid-payment), so they stay. No plugin adds a
         runtime ("dangerous") permission; location below is ours. -->
    <application
        android:label="Shyam Mobiles"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Portrait on phones: at 800x360 landscape the keyboard leaves ~150 dp for a form (address, checkout, admin
             editor), too little to see what you type. Targeting Android 16, the lock is ignored on large screens (sw600dp+), so
             tablets and unfolded foldables still rotate; the layouts there are wide and tall enough. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Shared links (lib/core/links.dart) open here; Flutter hands the URI to go_router, whose redirect sends
                 /open?p=&o=&ref= to the product, offer or Home. App Link: linkHost is LINK_HOST from the build's env
                 JSON (build.gradle.kts); verified by build/site/.well-known/assetlinks.json (scripts/launch.py). -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="true"/>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="${linkHost}" android:path="/open"/>
            </intent-filter>
            <!-- shyammobiles://open?…: site/open.html's intent:// button, and adb testing -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="shyammobiles" android:host="open"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Phone notifications (lib/core/push.dart): the feather mark in the status bar, not a white square -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_launcher_monochrome" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- url_launcher: call / WhatsApp the store, open links -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- Razorpay UPI intent: lets checkout list GPay / PhonePe / Paytm on Android 11+ -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="upi" android:host="pay"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
